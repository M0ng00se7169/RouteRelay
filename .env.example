# FastAPI app
API_PORT=8000

# JWT signing secret (HS256 serializer)
JWT_SECRET=supersecret

# OAuth2 password flow (single demo user)
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# MongoDB replica set
MONGO_DB_ADMIN_USERNAME=admin
MONGO_DB_ADMIN_PASSWORD=admin
MONGO_DB_CONNECTION_URI=mongodb://mongodb:27017?replicaSet=rs0

# Valkey (ADR-0008): host port for the valkey container. The app talks to it over
# the compose `backend` network, not via this port.
VALKEY_PORT=6379
# valkey-py URL. The `redis://` scheme is protocol-correct: Valkey speaks RESP,
# which is what the valkey-py client parses.
VALKEY_URL=redis://valkey:6379/0

# ADR-0008 feature flags. The knobs DEFAULT OFF in settings/config.py so a bare
# Config() (tests, pre-existing deployments) behaves exactly as before; the
# compose .env turns them ON, which is the only place the features are enabled.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
PRESENCE_ENABLED=true
PRESENCE_TTL_SECONDS=30
RELAY_LOCK_ENABLED=true
RELAY_LOCK_TTL_SECONDS=10

# Prometheus (metrics scraper)
PROMETHEUS_PORT=9090

# Observability stack
LOKI_PORT=3100
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Telegram alerting (ADR-0007 §4): Alertmanager sends directly via the built-in
# telegram_configs receiver. The bot token and chat id are NOT env vars — they
# live in gitignored files (docker_compose/alertmanager/secrets/), mounted into
# the container as compose file-secrets and read via bot_token_file/chat_id_file
# (AM config cannot expand env vars). Names reserved here for documentation.
# TELEGRAM_AM_BOT_TOKEN (file: docker_compose/alertmanager/secrets/telegram_bot_token)
# TELEGRAM_AM_CHAT_ID  (file: docker_compose/alertmanager/secrets/telegram_chat_id)